{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://emmavengerskidsworld-design.github.io/emmavengers-house-game/content/schema/v1/build.schema.json",
 "title": "content/src/build.json",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "channel",
  "channels",
  "player",
  "budgets"
 ],
 "properties": {
  "$schema": {
   "type": "string"
  },
  "note": {
   "type": "string"
  },
  "channel": {
   "type": "string"
  },
  "channels": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "statuses"
    ],
    "properties": {
     "statuses": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "uniqueItems": true
     },
     "locales": {
      "type": "array",
      "items": {
       "enum": [
        "active",
        "in-review",
        "planned",
        "test-only"
       ]
      },
      "uniqueItems": true,
      "description": "Language statuses this channel ships."
     },
     "out": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "lib",
       "lock"
      ],
      "properties": {
       "lib": {
        "type": "string"
       },
       "lock": {
        "type": "string"
       }
      }
     }
    },
    "additionalProperties": false
   }
  },
  "player": {
   "type": "object",
   "required": [
    "min"
   ],
   "properties": {
    "min": {
     "type": "string"
    },
    "maxExclusive": {
     "type": "string"
    }
   }
  },
  "retainReleases": {
   "type": "integer",
   "minimum": 1,
   "maximum": 10
  },
  "budgets": {
   "type": "object",
   "additionalProperties": {
    "type": "integer",
    "minimum": 1
   }
  },
  "write": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "uniqueItems": true,
   "description": "Channels a plain build writes (each needs out)."
  }
 }
}