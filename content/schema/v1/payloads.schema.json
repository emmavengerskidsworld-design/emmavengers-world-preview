{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://emmavengerskidsworld-design.github.io/emmavengers-house-game/content/schema/v1/payloads.schema.json",
 "title": "Payload shapes per record type (schema 1.0.0)",
 "description": "Closed objects: an unknown field is an error, so typos never silently vanish. lt = a localized text (any number of languages).",
 "$defs": {
  "lt": {
   "$ref": "common.schema.json#/$defs/localizedText"
  },
  "ref": {
   "$ref": "common.schema.json#/$defs/ref"
  },
  "key": {
   "$ref": "common.schema.json#/$defs/key"
  },
  "asset": {
   "$ref": "common.schema.json#/$defs/assetPath"
  },
  "refs": {
   "type": "array",
   "items": {
    "$ref": "common.schema.json#/$defs/ref"
   },
   "maxItems": 2000
  },
  "world": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "title",
    "img",
    "intro",
    "lands"
   ],
   "properties": {
    "formatVersion": {
     "type": "integer"
    },
    "title": {
     "$ref": "#/$defs/lt"
    },
    "img": {
     "$ref": "#/$defs/asset"
    },
    "intro": {
     "$ref": "#/$defs/lt"
    },
    "layout": {
     "enum": [
      "five",
      "six"
     ]
    },
    "bg2": {
     "$ref": "common.schema.json#/$defs/artName"
    },
    "lands": {
     "$ref": "#/$defs/refs",
     "minItems": 1
    }
   }
  },
  "land": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "key",
    "name",
    "color",
    "img",
    "intro",
    "layout",
    "places"
   ],
   "properties": {
    "key": {
     "$ref": "#/$defs/key"
    },
    "name": {
     "$ref": "#/$defs/lt"
    },
    "landType": {
     "enum": [
      "library"
     ]
    },
    "color": {
     "$ref": "common.schema.json#/$defs/color"
    },
    "img": {
     "$ref": "#/$defs/asset"
    },
    "music": {
     "type": "string",
     "pattern": "^[a-z0-9-]+$"
    },
    "intro": {
     "$ref": "#/$defs/lt"
    },
    "layout": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "x": {
       "$ref": "common.schema.json#/$defs/percent"
      },
      "y": {
       "$ref": "common.schema.json#/$defs/percent"
      },
      "sx": {
       "$ref": "common.schema.json#/$defs/percent"
      },
      "sy": {
       "$ref": "common.schema.json#/$defs/percent"
      },
      "w": {
       "type": "number"
      },
      "h": {
       "type": "number"
      },
      "m6": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "x": {
         "type": "number"
        },
        "y": {
         "type": "number"
        },
        "s": {
         "type": "number"
        },
        "art": {
         "anyOf": [
          {
           "$ref": "#/$defs/asset"
          },
          {
           "const": ""
          }
         ],
         "description": "'' = no small picture (uses art2)"
        },
        "art2": {
         "$ref": "common.schema.json#/$defs/artName"
        }
       }
      }
     }
    },
    "places": {
     "type": "array",
     "maxItems": 60,
     "items": {
      "$ref": "#/$defs/place"
     }
    }
   }
  },
  "place": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "key",
    "name",
    "type",
    "x",
    "y"
   ],
   "properties": {
    "key": {
     "$ref": "#/$defs/key"
    },
    "name": {
     "$ref": "#/$defs/lt"
    },
    "sub": {
     "$ref": "#/$defs/lt"
    },
    "icon": {
     "$ref": "#/$defs/asset"
    },
    "type": {
     "type": "string"
    },
    "x": {
     "$ref": "common.schema.json#/$defs/percent"
    },
    "y": {
     "$ref": "common.schema.json#/$defs/percent"
    },
    "go": {
     "type": "string"
    },
    "deck": {
     "$ref": "#/$defs/ref"
    },
    "objects": {
     "$ref": "#/$defs/ref"
    },
    "country": {
     "$ref": "#/$defs/ref"
    },
    "mode": {
     "type": "string"
    },
    "ask": {
     "$ref": "#/$defs/lt"
    },
    "rounds": {
     "type": "integer",
     "minimum": 1,
     "maximum": 50
    },
    "intro": {
     "$ref": "#/$defs/lt"
    },
    "photo": {
     "type": "boolean"
    },
    "pos": {
     "type": "string",
     "pattern": "^[0-9]{1,3}% [0-9]{1,3}%$"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "type": {
        "const": "link"
       }
      }
     },
     "then": {
      "required": [
       "go"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "enum": [
         "cards",
         "quiz"
        ]
       }
      }
     },
     "then": {
      "required": [
       "deck"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "quiz"
       }
      }
     },
     "then": {
      "required": [
       "mode",
       "ask"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "count"
       }
      }
     },
     "then": {
      "required": [
       "deck",
       "objects"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "country"
       }
      }
     },
     "then": {
      "required": [
       "country"
      ]
     }
    }
   ]
  },
  "deck": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "key",
    "kind",
    "items"
   ],
   "properties": {
    "key": {
     "$ref": "#/$defs/key"
    },
    "kind": {
     "type": "string"
    },
    "done": {
     "$ref": "#/$defs/lt"
    },
    "items": {
     "type": "array",
     "minItems": 1,
     "maxItems": 500,
     "items": {
      "$ref": "#/$defs/deckItem"
     }
    }
   }
  },
  "deckItem": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "maxLength": 40
    },
    "n": {
     "type": "integer"
    },
    "word": {
     "$ref": "#/$defs/lt"
    },
    "name": {
     "$ref": "#/$defs/lt"
    },
    "obj": {
     "type": "string"
    },
    "img": {
     "$ref": "#/$defs/asset"
    },
    "flag": {
     "$ref": "#/$defs/asset"
    },
    "foodImg": {
     "$ref": "#/$defs/asset"
    },
    "say": {
     "$ref": "common.schema.json#/$defs/localizedList"
    },
    "fact": {
     "$ref": "#/$defs/lt"
    },
    "text": {
     "$ref": "#/$defs/lt"
    },
    "greeting": {
     "$ref": "common.schema.json#/$defs/foreignText"
    },
    "meaning": {
     "$ref": "#/$defs/lt"
    },
    "language": {
     "$ref": "#/$defs/lt"
    },
    "food": {
     "$ref": "#/$defs/lt"
    },
    "plural": {
     "$ref": "#/$defs/lt"
    },
    "ask": {
     "$ref": "#/$defs/lt"
    },
    "hunt": {
     "type": "boolean"
    },
    "show": {
     "type": "string",
     "maxLength": 40
    },
    "nameDef": {
     "$ref": "#/$defs/lt",
     "description": "The name with its definite article in each language (\"the lion\", \"le lion\", \"la girafe\"), for question templates like \"Find {nameDef}!\"."
    },
    "nameOf": {
     "$ref": "#/$defs/lt",
     "description": "The name as the object of \"of\" (\"of Cameroon\", \"du Cameroun\", \"de l'Afrique du Sud\"), for templates like \"Quel est le drapeau {nameOf} ?\"."
    }
   },
   "anyOf": [
    {
     "required": [
      "id"
     ]
    },
    {
     "required": [
      "n"
     ]
    }
   ]
  },
  "library": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "prompt",
    "sections"
   ],
   "properties": {
    "prompt": {
     "$ref": "#/$defs/lt"
    },
    "sections": {
     "type": "array",
     "maxItems": 60,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "key",
       "name",
       "source"
      ],
      "properties": {
       "key": {
        "$ref": "#/$defs/key"
       },
       "name": {
        "$ref": "#/$defs/lt"
       },
       "color": {
        "$ref": "common.schema.json#/$defs/color"
       },
       "icon": {
        "$ref": "#/$defs/asset"
       },
       "icon2": {
        "$ref": "common.schema.json#/$defs/artName"
       },
       "intro": {
        "$ref": "#/$defs/lt"
       },
       "source": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "deck": {
          "$ref": "#/$defs/ref"
         },
         "module": {
          "type": "string"
         },
         "inline": {
          "const": true
         }
        },
        "minProperties": 1,
        "maxProperties": 1
       },
       "items": {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "name"
         ],
         "properties": {
          "name": {
           "$ref": "#/$defs/lt"
          },
          "img": {
           "$ref": "#/$defs/asset"
          },
          "text": {
           "$ref": "#/$defs/lt"
          },
          "say": {
           "$ref": "common.schema.json#/$defs/localizedList"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "lexicon": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "language",
    "entries"
   ],
   "properties": {
    "language": {
     "$ref": "common.schema.json#/$defs/locale"
    },
    "purpose": {
     "enum": [
      "voice-production"
     ]
    },
    "entries": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "text",
       "ipa"
      ],
      "properties": {
       "text": {
        "type": "string"
       },
       "ipa": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "character": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "key",
    "name"
   ],
   "properties": {
    "key": {
     "$ref": "#/$defs/key"
    },
    "name": {
     "$ref": "#/$defs/lt"
    },
    "species": {
     "type": "string"
    },
    "images": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/asset"
     }
    }
   }
  },
  "strings": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "strings"
   ],
   "properties": {
    "strings": {
     "type": "object",
     "maxProperties": 2000,
     "propertyNames": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
     },
     "additionalProperties": {
      "$ref": "#/$defs/lt"
     }
    }
   }
  },
  "country": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "slug",
    "name",
    "flag",
    "hub",
    "learn",
    "play",
    "quiz",
    "stories",
    "lines",
    "media"
   ],
   "properties": {
    "slug": {
     "type": "string",
     "pattern": "^[a-z0-9-]+$"
    },
    "name": {
     "$ref": "#/$defs/lt"
    },
    "externalIdentifiers": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "issuer",
       "code"
      ],
      "properties": {
       "issuer": {
        "type": "string"
       },
       "code": {
        "type": "string"
       },
       "checkedOn": {
        "$ref": "common.schema.json#/$defs/date"
       }
      }
     }
    },
    "flag": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "stripes"
     ],
     "properties": {
      "stripes": {
       "type": "array",
       "items": {
        "$ref": "common.schema.json#/$defs/color"
       },
       "minItems": 1,
       "maxItems": 13
      },
      "star": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "stripe": {
         "type": "integer",
         "minimum": 0
        },
        "color": {
         "$ref": "common.schema.json#/$defs/color"
        }
       }
      },
      "pole": {
       "enum": [
        "left",
        "top"
       ]
      },
      "colourNote": {
       "type": "string"
      }
     }
    },
    "hub": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "intro": {
       "$ref": "#/$defs/ref"
      },
      "introAgain": {
       "$ref": "#/$defs/ref"
      },
      "travel": {
       "$ref": "#/$defs/ref"
      }
     }
    },
    "learn": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "little",
      "big"
     ],
     "properties": {
      "little": {
       "$ref": "#/$defs/ref"
      },
      "big": {
       "$ref": "#/$defs/ref"
      }
     }
    },
    "practiceMap": {
     "type": "object"
    },
    "play": {
     "$ref": "#/$defs/refs"
    },
    "stories": {
     "$ref": "#/$defs/refs"
    },
    "lines": {
     "$ref": "#/$defs/refs"
    },
    "media": {
     "$ref": "#/$defs/refs"
    },
    "quiz": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "bank",
      "pools",
      "roundSize"
     ],
     "properties": {
      "bank": {
       "$ref": "#/$defs/ref"
      },
      "legacyLocaleKeys": {
       "type": "array",
       "items": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "minItems": 2,
        "maxItems": 2
       }
      },
      "pools": {
       "type": "object",
       "additionalProperties": {
        "type": "array",
        "items": {
         "$ref": "common.schema.json#/$defs/ageBand"
        }
       }
      },
      "roundSize": {
       "type": "object",
       "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30
       }
      },
      "exhausted": {
       "$ref": "#/$defs/lt"
      },
      "finish": {
       "$ref": "#/$defs/lt"
      },
      "practise": {
       "$ref": "#/$defs/lt"
      },
      "practiceLabel": {
       "$ref": "#/$defs/lt"
      }
     }
    },
    "breakAfterMinutes": {
     "type": "integer",
     "minimum": 1,
     "maximum": 120
    },
    "ui": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/lt"
     }
    }
   }
  },
  "topic": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "name"
   ],
   "properties": {
    "kind": {
     "enum": [
      "region",
      "theme",
      "city",
      "landmark"
     ]
    },
    "name": {
     "$ref": "#/$defs/lt"
    },
    "related": {
     "$ref": "#/$defs/refs"
    }
   },
   "description": "Reserved for non-country topics (Stage 5 lands)."
  },
  "source": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "key",
    "url",
    "checkedOn"
   ],
   "properties": {
    "key": {
     "type": "string"
    },
    "title": {
     "type": "string"
    },
    "url": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^https://"
    },
    "checkedOn": {
     "$ref": "common.schema.json#/$defs/date"
    },
    "locator": {
     "type": "string"
    },
    "note": {
     "type": "string"
    }
   }
  },
  "lesson": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "key",
    "cards"
   ],
   "properties": {
    "key": {
     "$ref": "#/$defs/key"
    },
    "cards": {
     "$ref": "#/$defs/refs",
     "minItems": 1,
     "maxItems": 50
    }
   }
  },
  "learnCard": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "key",
    "kind",
    "text"
   ],
   "properties": {
    "key": {
     "$ref": "#/$defs/key"
    },
    "kind": {
     "enum": [
      "info",
      "map-intro",
      "model",
      "try"
     ]
    },
    "image": {
     "$ref": "#/$defs/ref"
    },
    "text": {
     "$ref": "#/$defs/lt"
    },
    "lines": {
     "$ref": "#/$defs/refs"
    }
   }
  },
  "activity": {
   "type": "object",
   "required": [
    "key",
    "template",
    "title"
   ],
   "properties": {
    "key": {
     "$ref": "#/$defs/key"
    },
    "template": {
     "type": "string",
     "pattern": "^[a-z-]+\\.v[0-9]+$"
    },
    "icon": {
     "type": "string",
     "maxLength": 16
    },
    "title": {
     "$ref": "#/$defs/lt"
    },
    "lines": {
     "$ref": "#/$defs/refs"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "template": {
        "const": "grid-route.v1"
       }
      }
     },
     "then": {
      "additionalProperties": false,
      "required": [
       "mission",
       "start",
       "goal",
       "feedback"
      ],
      "properties": {
       "key": true,
       "template": true,
       "icon": true,
       "title": true,
       "lines": true,
       "mission": {
        "$ref": "#/$defs/lt"
       },
       "start": {
        "type": "array",
        "items": {
         "type": "integer",
         "minimum": 0
        },
        "minItems": 2,
        "maxItems": 2
       },
       "goal": {
        "type": "string"
       },
       "shortest": {
        "type": "integer",
        "minimum": 1
       },
       "routeHelpAfter": {
        "type": "integer",
        "minimum": 1
       },
       "countMoves": {
        "type": "boolean"
       },
       "feedback": {
        "type": "object",
        "additionalProperties": {
         "$ref": "#/$defs/lt"
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "template": {
        "const": "ordered-slots.v1"
       }
      }
     },
     "then": {
      "additionalProperties": false,
      "required": [
       "prompt",
       "pieces"
      ],
      "properties": {
       "key": true,
       "template": true,
       "icon": true,
       "title": true,
       "lines": true,
       "prompt": {
        "$ref": "#/$defs/lt"
       },
       "hint": {
        "$ref": "#/$defs/lt"
       },
       "success": {
        "$ref": "#/$defs/lt"
       },
       "pieces": {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "id",
          "name",
          "slot"
         ],
         "properties": {
          "id": {
           "type": "string"
          },
          "name": {
           "$ref": "#/$defs/lt"
          },
          "slot": {
           "type": [
            "integer",
            "string"
           ]
          }
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "template": {
        "const": "match.v1"
       }
      }
     },
     "then": {
      "additionalProperties": false,
      "required": [
       "prompt",
       "pairs"
      ],
      "properties": {
       "key": true,
       "template": true,
       "icon": true,
       "title": true,
       "lines": true,
       "prompt": {
        "$ref": "#/$defs/lt"
       },
       "success": {
        "$ref": "#/$defs/lt"
       },
       "pairs": {
        "type": "array",
        "minItems": 2,
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "id",
          "name"
         ],
         "properties": {
          "id": {
           "type": "string"
          },
          "scene": {
           "type": "string"
          },
          "name": {
           "$ref": "#/$defs/lt"
          }
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "template": {
        "const": "map-select.v1"
       }
      }
     },
     "then": {
      "additionalProperties": false,
      "required": [
       "prompts",
       "neighbours"
      ],
      "properties": {
       "key": true,
       "template": true,
       "icon": true,
       "title": true,
       "lines": true,
       "hint": {
        "$ref": "#/$defs/lt"
       },
       "prompts": {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "dir",
          "ask",
          "accept"
         ],
         "properties": {
          "dir": {
           "enum": [
            "n",
            "ne",
            "e",
            "se",
            "s",
            "sw",
            "w",
            "nw"
           ]
          },
          "ask": {
           "$ref": "#/$defs/lt"
          },
          "accept": {
           "type": "array",
           "items": {
            "type": "string"
           },
           "minItems": 1
          }
         }
        }
       },
       "neighbours": {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "id",
          "pos",
          "name"
         ],
         "properties": {
          "id": {
           "type": "string"
          },
          "pos": {
           "enum": [
            "n",
            "ne",
            "e",
            "se",
            "s",
            "sw",
            "w",
            "nw"
           ]
          },
          "name": {
           "$ref": "#/$defs/lt"
          }
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "template": {
        "const": "evidence-comparison.v1"
       }
      }
     },
     "then": {
      "additionalProperties": false,
      "required": [
       "table",
       "questions"
      ],
      "properties": {
       "key": true,
       "template": true,
       "icon": true,
       "title": true,
       "lines": true,
       "caption": {
        "$ref": "#/$defs/lt"
       },
       "feedback": {
        "$ref": "#/$defs/lt"
       },
       "table": {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "properties": {
          "source": {
           "$ref": "#/$defs/lt"
          },
          "value": {
           "$ref": "#/$defs/lt"
          }
         }
        }
       },
       "questions": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/choiceQuestion"
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "template": {
        "const": "inquiry.v1"
       }
      }
     },
     "then": {
      "additionalProperties": false,
      "required": [
       "table",
       "task",
       "claimFromQuiz",
       "next"
      ],
      "properties": {
       "key": true,
       "template": true,
       "icon": true,
       "title": true,
       "lines": true,
       "caption": {
        "$ref": "#/$defs/lt"
       },
       "task": {
        "$ref": "#/$defs/lt"
       },
       "feedback": {
        "$ref": "#/$defs/lt"
       },
       "table": {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "properties": {
          "label": {
           "$ref": "#/$defs/lt"
          },
          "value": {
           "type": "number"
          }
         }
        }
       },
       "claimFromQuiz": {
        "$ref": "#/$defs/ref"
       },
       "next": {
        "$ref": "#/$defs/choiceQuestion"
       }
      }
     }
    }
   ]
  },
  "choiceQuestion": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "key",
    "options"
   ],
   "properties": {
    "ask": {
     "$ref": "#/$defs/lt"
    },
    "key": {
     "type": "string"
    },
    "options": {
     "type": "object",
     "minProperties": 2,
     "maxProperties": 6,
     "additionalProperties": {
      "$ref": "#/$defs/lt"
     }
    }
   }
  },
  "quizBank": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "items"
   ],
   "properties": {
    "items": {
     "$ref": "#/$defs/refs",
     "minItems": 1
    },
    "sources": {
     "$ref": "#/$defs/refs"
    },
    "roundRules": {
     "type": "object"
    }
   }
  },
  "quizItem": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "responseType",
    "prompt",
    "options",
    "answerKey"
   ],
   "properties": {
    "responseType": {
     "enum": [
      "single-choice",
      "multi-choice",
      "ordered-choice",
      "select-pair",
      "numeric",
      "adult-rubric"
     ]
    },
    "construct": {
     "type": "string",
     "pattern": "^[a-z0-9-]+$"
    },
    "prompt": {
     "$ref": "#/$defs/lt"
    },
    "options": {
     "type": "object",
     "minProperties": 2,
     "maxProperties": 6,
     "propertyNames": {
      "pattern": "^[a-z0-9-]{1,32}$"
     },
     "additionalProperties": {
      "$ref": "#/$defs/lt"
     }
    },
    "hint": {
     "$ref": "#/$defs/lt"
    },
    "feedback": {
     "$ref": "#/$defs/lt"
    },
    "answerKey": {
     "type": "string"
    },
    "readAloudAllowed": {
     "type": "boolean"
    },
    "shuffleOptions": {
     "type": "boolean"
    },
    "equivalenceGroup": {
     "type": "string"
    }
   }
  },
  "story": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "classification",
    "title",
    "pages"
   ],
   "properties": {
    "classification": {
     "type": "string"
    },
    "title": {
     "$ref": "#/$defs/lt"
    },
    "banner": {
     "$ref": "#/$defs/lt"
    },
    "pages": {
     "type": "object",
     "minProperties": 1,
     "propertyNames": {
      "enum": [
       "all",
       "little",
       "big"
      ]
     },
     "additionalProperties": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "text"
       ],
       "properties": {
        "text": {
         "$ref": "#/$defs/lt"
        },
        "scene": {
         "type": "string"
        }
       }
      }
     }
    },
    "reflection": {
     "type": "object",
     "propertyNames": {
      "enum": [
       "all",
       "little",
       "big"
      ]
     },
     "additionalProperties": {
      "$ref": "#/$defs/lt"
     }
    },
    "sourcePassages": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "line": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "key",
    "speaker",
    "text"
   ],
   "properties": {
    "key": {
     "type": "string",
     "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "speaker": {
     "$ref": "#/$defs/ref"
    },
    "text": {
     "$ref": "#/$defs/lt"
    }
   }
  },
  "media": {
   "type": "object",
   "required": [
    "key",
    "kind"
   ],
   "properties": {
    "key": {
     "$ref": "#/$defs/key"
    },
    "kind": {
     "type": "string"
    },
    "assetId": {
     "type": "string"
    },
    "icon": {
     "type": "string",
     "maxLength": 16
    },
    "label": {
     "$ref": "#/$defs/lt"
    },
    "alt": {
     "$ref": "#/$defs/lt"
    },
    "file": {
     "$ref": "#/$defs/asset"
    },
    "scenes": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "scene": {
     "type": "string"
    },
    "arrow": {
     "type": "string"
    },
    "highlight": {
     "type": "string"
    },
    "interactive": {
     "type": "boolean"
    },
    "goal": {
     "type": "string"
    },
    "n": {
     "type": "integer"
    },
    "cities": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "name": {
        "type": "string",
        "description": "proper name, same in every language"
       },
       "icon": {
        "type": "string"
       }
      }
     }
    },
    "rows": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "label": {
        "$ref": "#/$defs/lt"
       },
       "value": {
        "type": "number"
       }
      }
     }
    }
   },
   "additionalProperties": false,
   "allOf": [
    {
     "if": {
      "properties": {
       "kind": {
        "const": "placeholder"
       }
      }
     },
     "then": {
      "required": [
       "label"
      ]
     }
    }
   ]
  },
  "mission": {
   "type": "object",
   "additionalProperties": false,
   "description": "Daily Ari Mission: one small real-life task done AWAY from the screen (a chore, kindness, gratitude, prayer...). The screen only gives the task; a grown-up confirms it really happened. Data only: when missions show and how strict they are is decided by the settings record (ew.settings.app) and the parent's choices on the device, never by the mission.",
   "required": [
    "key",
    "kind",
    "title",
    "task",
    "parentConfirm"
   ],
   "properties": {
    "key": {
     "$ref": "#/$defs/key"
    },
    "kind": {
     "type": "string",
     "description": "taxonomy.missionKinds"
    },
    "speaker": {
     "$ref": "#/$defs/ref",
     "description": "character who gives the mission (default Ari)"
    },
    "title": {
     "$ref": "#/$defs/lt"
    },
    "task": {
     "$ref": "#/$defs/lt",
     "description": "what the guide says, one or two short sentences a 5-year-old understands"
    },
    "steps": {
     "type": "array",
     "maxItems": 5,
     "items": {
      "$ref": "#/$defs/lt"
     }
    },
    "doneText": {
     "$ref": "#/$defs/lt",
     "description": "praise line after the grown-up confirms"
    },
    "where": {
     "enum": [
      "home",
      "outdoors",
      "anywhere",
      "travel"
     ]
    },
    "timeOfDay": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "type": "string"
     },
     "description": "taxonomy.timesOfDay; bedtime missions are the only ones bedtime mode may show"
    },
    "minutes": {
     "type": "integer",
     "minimum": 1,
     "maximum": 60
    },
    "parentConfirm": {
     "type": "boolean",
     "description": "true = a grown-up must confirm through the parent gate before the star is given"
    },
    "proof": {
     "enum": [
      "parent-check",
      "draw",
      "tell",
      "none"
     ],
     "description": "how the child shows it was done (draw = a drawing on the device for trips or when no grown-up is near)"
    },
    "adultNearby": {
     "type": "boolean",
     "description": "true = only with a grown-up close by (kitchen, water, tools, outdoors)"
    },
    "parentNote": {
     "$ref": "#/$defs/lt",
     "description": "shown only in the Parents' Corner"
    },
    "stars": {
     "type": "integer",
     "minimum": 1,
     "maximum": 3
    },
    "scripture": {
     "type": "array",
     "maxItems": 5,
     "items": {
      "type": "string"
     },
     "description": "Bible references only (e.g. 'Ephesians 6:1'), no quoted text"
    }
   }
  },
  "together": {
   "type": "object",
   "additionalProperties": false,
   "description": "Together Time: something a parent and child do side by side (audience parent-and-child), or a short tip for the parent shown in the Parents' Corner (audience parent, kind parent-tip). Tips state facts, so they must cite sources.",
   "required": [
    "key",
    "kind",
    "audience",
    "title",
    "steps"
   ],
   "properties": {
    "key": {
     "$ref": "#/$defs/key"
    },
    "kind": {
     "type": "string",
     "description": "taxonomy.togetherKinds"
    },
    "audience": {
     "enum": [
      "parent-and-child",
      "parent"
     ]
    },
    "title": {
     "$ref": "#/$defs/lt"
    },
    "intro": {
     "$ref": "#/$defs/lt"
    },
    "steps": {
     "type": "array",
     "minItems": 1,
     "maxItems": 10,
     "items": {
      "$ref": "#/$defs/lt"
     }
    },
    "talkAbout": {
     "type": "array",
     "maxItems": 6,
     "items": {
      "$ref": "#/$defs/lt"
     },
     "description": "questions for the parent to ask the child"
    },
    "materials": {
     "type": "array",
     "maxItems": 10,
     "items": {
      "$ref": "#/$defs/lt"
     }
    },
    "minutes": {
     "type": "integer",
     "minimum": 1,
     "maximum": 120
    },
    "cadence": {
     "enum": [
      "any",
      "daily",
      "weekly"
     ]
    },
    "timeOfDay": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "type": "string"
     }
    },
    "screen": {
     "enum": [
      "off",
      "on",
      "either"
     ],
     "description": "off = the device is put away for the activity"
    },
    "links": {
     "$ref": "#/$defs/refs",
     "description": "related records in the library (a story, a lesson) - never web links"
    },
    "scripture": {
     "type": "array",
     "maxItems": 5,
     "items": {
      "type": "string"
     }
    }
   }
  },
  "settings": {
   "type": "object",
   "additionalProperties": false,
   "description": "App rules as data (ew.settings.app). Every rule has an on/off switch and its numbers here, so a rule can be switched on, changed or switched off by publishing a new content release - no app rebuild. These are the app-wide defaults and limits; a parent's own choices on the device (Parents' Corner) override them inside the min/max given here. A rule the running app does not know yet is ignored by it (library.js settings()).",
   "required": [
    "key"
   ],
   "properties": {
    "key": {
     "$ref": "#/$defs/key"
    },
    "missions": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "enabled": {
       "type": "boolean"
      },
      "defaultMode": {
       "enum": [
        "gentle",
        "firm",
        "off"
       ],
       "description": "gentle = mission shows, play continues; firm = the rest of the app waits for the grown-up check; off = no missions"
      },
      "modes": {
       "type": "array",
       "uniqueItems": true,
       "minItems": 1,
       "items": {
        "enum": [
         "gentle",
         "firm",
         "off"
        ]
       },
       "description": "modes a parent may choose"
      },
      "showOnOpen": {
       "type": "boolean"
      },
      "laterAllowed": {
       "type": "integer",
       "minimum": 0,
       "maximum": 5,
       "description": "how many times the child may say 'Later' before the reminder"
      },
      "breakAfterMinutes": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "default",
        "min",
        "max"
       ],
       "properties": {
        "default": {
         "type": [
          "integer",
          "null"
         ],
         "minimum": 5,
         "maximum": 180
        },
        "min": {
         "type": "integer",
         "minimum": 5,
         "maximum": 180
        },
        "max": {
         "type": "integer",
         "minimum": 5,
         "maximum": 180
        }
       }
      },
      "perDay": {
       "type": "integer",
       "minimum": 1,
       "maximum": 5
      },
      "confirm": {
       "enum": [
        "parent-gate",
        "none"
       ]
      },
      "starsUnlock": {
       "type": "boolean",
       "description": "stars from missions unlock extras (games, stories, Ari outfits)"
      },
      "kinds": {
       "type": "array",
       "uniqueItems": true,
       "items": {
        "type": "string"
       },
       "description": "mission kinds in rotation (taxonomy.missionKinds)"
      }
     }
    },
    "parentGate": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "methods": {
       "type": "array",
       "uniqueItems": true,
       "minItems": 1,
       "items": {
        "enum": [
         "math",
         "pin",
         "hold"
        ]
       }
      },
      "primary": {
       "enum": [
        "math",
        "pin",
        "hold"
       ]
      },
      "fallback": {
       "enum": [
        "math",
        "pin",
        "hold"
       ]
      },
      "pinLength": {
       "type": "integer",
       "minimum": 4,
       "maximum": 8
      },
      "maxTries": {
       "type": "integer",
       "minimum": 1,
       "maximum": 20
      },
      "lockSeconds": {
       "type": "integer",
       "minimum": 0,
       "maximum": 3600
      },
      "logConfirmations": {
       "type": "boolean",
       "description": "keep a list of grown-up checks for the Parents' Corner (on the device only)"
      }
     }
    },
    "screenTime": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "enabled": {
       "type": "boolean"
      },
      "dailyMinutes": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "default",
        "min",
        "max"
       ],
       "properties": {
        "default": {
         "type": [
          "integer",
          "null"
         ],
         "minimum": 5,
         "maximum": 600
        },
        "min": {
         "type": "integer",
         "minimum": 5,
         "maximum": 600
        },
        "max": {
         "type": "integer",
         "minimum": 5,
         "maximum": 600
        }
       }
      },
      "warnBeforeMinutes": {
       "type": "integer",
       "minimum": 0,
       "maximum": 30
      },
      "end": {
       "enum": [
        "gentle-goodbye"
       ],
       "description": "how time-up looks: the guide says goodbye and suggests something to do offline (no sudden cut-off)"
      },
      "offlineIdeas": {
       "type": "boolean"
      }
     }
    },
    "bedtime": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "enabled": {
       "type": "boolean"
      },
      "start": {
       "type": "string",
       "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
      },
      "end": {
       "type": "string",
       "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
      },
      "dim": {
       "type": "boolean"
      },
      "allowTimeOfDay": {
       "type": "array",
       "uniqueItems": true,
       "items": {
        "type": "string"
       },
       "description": "only content tagged with these times (taxonomy.timesOfDay) stays open"
      },
      "allowTypes": {
       "type": "array",
       "uniqueItems": true,
       "items": {
        "type": "string"
       },
       "description": "record types that stay open (e.g. story, together)"
      },
      "musicOff": {
       "type": "boolean"
      }
     }
    },
    "together": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "enabled": {
       "type": "boolean"
      },
      "tipCadence": {
       "enum": [
        "daily",
        "weekly"
       ]
      },
      "tipWeekday": {
       "type": "integer",
       "minimum": 0,
       "maximum": 6,
       "description": "0 = Sunday"
      }
     }
    },
    "parentsMayChange": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^[a-zA-Z]+\\.[a-zA-Z]+$"
     },
     "description": "settings a parent may change on the device, e.g. 'missions.defaultMode'"
    }
   }
  }
 }
}