{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://emmavengerskidsworld-design.github.io/emmavengers-house-game/content/schema/v1/locales.schema.json",
 "title": "content/src/locales.json - the language registry",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "sourceLocale",
  "locales"
 ],
 "properties": {
  "$schema": {
   "type": "string"
  },
  "note": {
   "type": "string"
  },
  "sourceLocale": {
   "$ref": "common.schema.json#/$defs/locale"
  },
  "locales": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "tag",
     "name",
     "englishName",
     "dir",
     "script",
     "status",
     "fallback"
    ],
    "properties": {
     "tag": {
      "$ref": "common.schema.json#/$defs/locale"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "dir": {
      "enum": [
       "ltr",
       "rtl"
      ]
     },
     "status": {
      "enum": [
       "active",
       "in-review",
       "planned",
       "test-only"
      ]
     },
     "note": {
      "type": "string"
     },
     "englishName": {
      "type": "string",
      "minLength": 1,
      "description": "Name in English, for the parents area and reports."
     },
     "script": {
      "type": "string",
      "pattern": "^[A-Z][a-z]{3}$",
      "description": "ISO 15924 script code (Latn, Arab, Deva, Ethi, Hans...). Picks the font stack from scripts."
     },
     "fallback": {
      "type": "array",
      "items": {
       "$ref": "common.schema.json#/$defs/locale"
      },
      "uniqueItems": true,
      "description": "Languages to show, in order, when a text is missing. The source language is always the last resort. A regional tag (fr-CM) first falls back to its base language (fr) automatically."
     },
     "numberingSystem": {
      "type": "string",
      "pattern": "^[a-z]{3,8}$",
      "description": "Unicode numbering system for numbers (latn, arab, deva...). Default: the language default from CLDR via Intl."
     },
     "voice": {
      "oneOf": [
       {
        "type": "null"
       },
       {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "pack",
         "engine"
        ],
        "properties": {
         "pack": {
          "type": "string",
          "pattern": "^voice/([a-z0-9-]+/)?$",
          "description": "Folder of the clips: voice/ or voice/<tag>/. File name = FNV-1a hash of the exact text."
         },
         "engine": {
          "enum": [
           "kokoro",
           "recorded"
          ]
         },
         "voice": {
          "type": "string"
         },
         "lang": {
          "type": "string"
         },
         "speed": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 1.5
         },
         "pitch": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.6
         },
         "note": {
          "type": "string"
         },
         "model": {
          "enum": [
           "int8",
           "fp32",
           "fp16"
          ],
          "description": "Kokoro model precision (fp32 = cleanest; tools/gen_voice.py)"
         },
         "bitrate": {
          "type": "string",
          "pattern": "^[0-9]{2,3}k$",
          "description": "MP3 bitrate; 32k cuts the voice above ~6 kHz (muffled)"
         },
         "blend": {
          "type": "array",
          "items": {
           "type": "array",
           "prefixItems": [
            {
             "type": "string"
            },
            {
             "type": "number",
             "minimum": 0,
             "maximum": 0.9
            }
           ],
           "minItems": 2,
           "maxItems": 2
          },
          "description": "Other Kokoro voices mixed into the main voice's style: [[voice, weight], ...]"
         },
         "post": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
           "highpass": {
            "type": "number",
            "minimum": 20,
            "maximum": 400
           },
           "presence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
             "f",
             "g"
            ],
            "properties": {
             "f": {
              "type": "number"
             },
             "g": {
              "type": "number",
              "minimum": -12,
              "maximum": 12
             },
             "w": {
              "type": "number"
             }
            }
           },
           "air": {
            "type": "object",
            "additionalProperties": false,
            "required": [
             "f",
             "g"
            ],
            "properties": {
             "f": {
              "type": "number"
             },
             "g": {
              "type": "number",
              "minimum": -12,
              "maximum": 12
             }
            }
           },
           "deess": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
           },
           "denoise": {
            "type": "number",
            "minimum": 0,
            "maximum": 30
           },
           "gate": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
             "threshold": {
              "type": "number"
             },
             "ratio": {
              "type": "number"
             }
            }
           }
          },
          "description": "Clean-up after synthesis (tools/voice_post.py)."
         },
         "verifyShort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6,
          "description": "Lines of up to this many words are listened to (Whisper) and re-taken if garbled"
         },
         "next": {
          "type": "object",
          "description": "A voice set-up chosen but not yet recorded (gen_voice.py --next renders with it); becomes the voice once all clips are regenerated."
         }
        }
       }
      ],
      "description": "How this language is spoken. null = no voice yet (text only)."
     }
    }
   }
  },
  "scripts": {
   "type": "object",
   "patternProperties": {
    "^[A-Z][a-z]{3}$": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "fonts"
     ],
     "properties": {
      "fonts": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "minItems": 1
      },
      "note": {
       "type": "string"
      }
     }
    }
   },
   "additionalProperties": false
  }
 }
}
